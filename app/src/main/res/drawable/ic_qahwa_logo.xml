<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep Forest Green Emblem Circle (matching Photo 1 & 2) -->
    <path
        android:pathData="M54,54m-40,0a40,40 0,1 1,80 0a40,40 0,1 1,-80 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="20"
                android:startY="20"
                android:endX="88"
                android:endY="88"
                android:type="linear">
                <item android:color="#2E634D" android:offset="0.0" />
                <item android:color="#1E4635" android:offset="0.55" />
                <item android:color="#143023" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle inner ring -->
    <path
        android:pathData="M54,54m-33,0a33,33 0,1 1,66 0a33,33 0,1 1,-66 0"
        android:strokeWidth="0.8"
        android:strokeColor="#26F4EFEA"
        android:fillColor="#00000000" />

    <!-- Cream Coffee Bean Body -->
    <path
        android:pathData="M54,32 C42.5,32 34.5,41.5 34.5,54 C34.5,66.5 42.5,76 54,76 C65.5,76 73.5,66.5 73.5,54 C73.5,41.5 65.5,32 54,32 Z"
        android:fillColor="#F4EFEA" />

    <!-- S-Curve Coffee Bean Crease -->
    <path
        android:pathData="M51,33.5 C49,41 53.5,47.5 56,54 C58.5,60.5 55,68.5 57.5,74.5"
        android:strokeWidth="3.2"
        android:strokeColor="#1A3E2E"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Signature Warm Amber Gold Dot at top-right -->
    <path
        android:pathData="M78,27m-6.5,0a6.5,6.5 0,1 1,13 0a6.5,6.5 0,1 1,-13 0"
        android:fillColor="#E2A165" />

</vector>
